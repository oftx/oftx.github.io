---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tools Collection">
	<main class="container">
		<div class="header-actions">
			<h1>Tools Collection</h1>
			<button onclick="window.toggleTheme()" class="theme-toggle" aria-label="Toggle theme">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
			</button>
		</div>
		<div class="grid">
			<a href="/frequency" class="card">
				<h2>Frequency Generator</h2>
				<p>Generate sounds of different frequencies.</p>
			</a>
			<a href="/freq" class="card">
				<h2>FreqSndGen</h2>
				<p>Stereo frequency generator with waveforms.</p>
			</a>
			<a href="/piano" class="card">
				<h2>Virtual Piano</h2>
				<p>Play piano in your browser.</p>
			</a>
			<a href="/pendulum" class="card">
				<h2>Double Pendulum</h2>
				<p>Double pendulum simulation with trails.</p>
			</a>
			<a href="/arthrosim" class="card">
				<h2>ArthroSim</h2>
				<p>Arthropod simulation using inverse kinematics.</p>
			</a>
			<a href="/pitchtrack" class="card">
				<h2>Pitch Track</h2>
				<p>Real-time pitch tracking and visualization.</p>
			</a>
			<a href="/kfk2060" class="card">
				<h2>KFK2060</h2>
				<p>Documentation/Story.</p>
			</a>
			<a href="/fading-board" class="card">
				<h2>Fading Board</h2>
				<p>Zen-style fading handwriting board.</p>
			</a>
		</div>
	</main>
</Layout>

<style>
	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 4rem 2rem;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.header-actions {
		display: flex;
		justify-content: center;
		align-items: center;
		position: relative;
		margin-bottom: 3rem;
	}
	h1 {
		font-size: 2.5rem;
		font-weight: 700;
		text-align: center;
		background: linear-gradient(45deg, var(--topbar-text-color), #666);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		letter-spacing: -0.02em;
		margin: 0;
	}
	.theme-toggle {
		position: absolute;
		right: 0;
		background: var(--control-button-bg-color);
		border: 1px solid var(--control-button-border-color);
		color: var(--topbar-text-color);
		width: 40px;
		height: 40px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.theme-toggle:hover {
		background: var(--default-button-hover-bg-color);
		transform: scale(1.05);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}
	.card {
		background: var(--control-button-bg-color);
		padding: 2rem;
		border-radius: 16px;
		text-decoration: none;
		color: var(--topbar-text-color);
		border: 1px solid var(--control-button-border-color);
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
	}
	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
		border-color: var(--slider-thumb-bg-color);
	}
	h2 {
		margin: 0 0 0.75rem 0;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--topbar-text-color);
	}
	p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--default-button-color);
	}
</style>
