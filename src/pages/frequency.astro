---
import Layout from '../layouts/Layout.astro';
---

<Layout title="频率声音发生">
    <div class="big-container">
        <div id="blank-top"></div>
        <div class="container">
            <div class="topbar">
                <div class="topbar-left">
                    <p>频率声音发生</p>
                </div>
                <div class="topbar-right">
                    <button id="theme-toggle" onclick="window.toggleTheme()">切换主题</button>
                </div>
            </div>
            <div class="left">
                <div class="output-container">
                    <div id="output"></div>
                </div>
            </div>
            <div class="main">
                <div class="value-container">
                    <div id="blank-left"></div>
                    <button class="control-button" id="decrease">⇦</button>
                    <div id="blank-left"></div>
                    <input id="hzValue" />
                    <span id="hz-unit">Hz</span>
                    <button class="control-button" id="increase">⇨</button>
                    <div id="blank-right"></div>
                </div>
                <div class="slider-container">
                    <div class="audio-hz-slider">
                        <input type="range" min="0" max="22050" value="400" class="slider" id="hzRange">
                    </div>
                </div>
                <div class="button-container">
                    <button onclick="playSound()" class="default-button">播放</button>
                    <button onclick="stopSound()" class="default-button">停止</button>
                </div>
            </div>
        </div>
        <div class="bottom">
            <div class="bottom-element">
                <a href="https://github.com/oftx/oftx.github.io">
                    <svg height="32" aria-hidden="true" viewBox="0 0 16 16" version="1.1" width="32"
                        data-view-component="true" class="octicon octicon-mark-github v-align-middle">
                        <path
                            d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z">
                        </path>
                    </svg>
                </a>
            </div>
            <div class="bottom-element"><a href="/">Home</a></div>
        </div>
    </div>

    <style>
        .light-theme {
            --body-bg-color: #ffffff;
            --topbar-background-color: #ffffff;
            --topbar-text-color: #000000;
            --theme-toggle-button-background-color: #ffffff;
            --theme-toggle-button-text-color: #000000;
            --theme-toggle-button-hover-background-color: #f2f2f2;
            --theme-toggle-button-active-background-color: #e6e6e6;
            --control-button-bg-color: #f8f8f8;
            --control-button-border-color: #cccccc;
            --control-button-color: #686868;
            --default-button-bg-color: #f2f2f2;
            --default-button-border-color: #c7c7c7;
            --default-button-color: #686868;
            --default-button-hover-bg-color: #e0e0e0;
            --default-button-active-bg-color: #d6d6d6;
            --output-container-color: #000000;
            --output-container-bg-color: #f3f3f3;
            --output-container-border-color: #c5c5c5;
            --output-container-scrollbar-thumb-bg-color: #33333366;
            --slider-bg-color: #ddd;
            --slider-thumb-bg-color: #1389ff;
            --input-border-color: #ddd;
            --input-bg-color: #ffffff;
            --input-color: #000000;
            --span-hz-unit-color: #797979;
            --github-logo-fill-color: #000000;
        }

        .dark-theme {
            --body-bg-color: #000000;
            --topbar-background-color: #000000;
            --topbar-text-color: #ffffff;
            --theme-toggle-button-background-color: #000000;
            --theme-toggle-button-text-color: #ffffff;
            --theme-toggle-button-hover-background-color: #333333;
            --theme-toggle-button-active-background-color: #484848;
            --control-button-bg-color: #333333;
            --control-button-border-color: #4f4f4f;
            --control-button-color: #ffffff;
            --default-button-bg-color: #333333;
            --default-button-border-color: #000000;
            --default-button-color: #ccc;
            --default-button-hover-bg-color: #444444;
            --default-button-active-bg-color: #535353;
            --output-container-color: #ccc;
            --output-container-bg-color: #212121;
            --output-container-border-color: #313131;
            --output-container-scrollbar-thumb-bg-color: #ffffff66;
            --slider-bg-color: #333333;
            --slider-thumb-bg-color: #005cb8;
            --input-border-color: #333333;
            --input-bg-color: #333333;
            --input-color: #cdcdcd;
            --span-hz-unit-color: #797979;
            --github-logo-fill-color: #ffffff;
        }

        @media (prefers-color-scheme: light) {
            :root {
                --body-bg-color: #ffffff;
                --topbar-background-color: #ffffff;
                --topbar-text-color: #000000;
                --theme-toggle-button-background-color: #ffffff;
                --theme-toggle-button-text-color: #000000;
                --theme-toggle-button-hover-background-color: #f2f2f2;
                --theme-toggle-button-active-background-color: #e6e6e6;
                --control-button-bg-color: #f8f8f8;
                --control-button-border-color: #cccccc;
                --control-button-color: #686868;
                --default-button-bg-color: #f2f2f2;
                --default-button-border-color: #c7c7c7;
                --default-button-color: #686868;
                --default-button-hover-bg-color: #e0e0e0;
                --default-button-active-bg-color: #d6d6d6;
                --output-container-color: #000000;
                --output-container-bg-color: #f3f3f3;
                --output-container-border-color: #c5c5c5;
                --output-container-scrollbar-thumb-bg-color: #33333366;
                --slider-bg-color: #ddd;
                --slider-thumb-bg-color: #1389ff;
                --input-border-color: #ddd;
                --input-bg-color: #ffffff;
                --input-color: #000000;
                --span-hz-unit-color: #797979;
                --github-logo-fill-color: #000000;
            }
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --body-bg-color: #000000;
                --topbar-background-color: #000000;
                --topbar-text-color: #ffffff;
                --theme-toggle-button-background-color: #000000;
                --theme-toggle-button-text-color: #ffffff;
                --theme-toggle-button-hover-background-color: #333333;
                --theme-toggle-button-active-background-color: #484848;
                --control-button-bg-color: #333333;
                --control-button-border-color: #4f4f4f;
                --control-button-color: #ffffff;
                --default-button-bg-color: #333333;
                --default-button-border-color: #000000;
                --default-button-color: #ccc;
                --default-button-hover-bg-color: #444444;
                --default-button-active-bg-color: #535353;
                --output-container-color: #ccc;
                --output-container-bg-color: #212121;
                --output-container-border-color: #313131;
                --output-container-scrollbar-thumb-bg-color: #ffffff66;
                --slider-bg-color: #333333;
                --slider-thumb-bg-color: #005cb8;
                --input-border-color: #333333;
                --input-bg-color: #333333;
                --input-color: #cdcdcd;
                --span-hz-unit-color: #797979;
                --github-logo-fill-color: #ffffff;
            }
        }

        body {
            height: 90vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--body-bg-color);
            transition: all 1s ease-in-out;
        }

        .topbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 999;
            background-color: var(--topbar-background-color);
            color: var(--topbar-text-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 50px;
            padding: 0 20px;
            transition: all 1s ease-in-out;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
            transition: all 1s ease-in-out;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 20px;
            transition: all 1s ease-in-out;
        }

        #theme-toggle {
            background-color: var(--theme-toggle-button-background-color);
            color: var(--theme-toggle-button-text-color);
            font-size: 16px;
            padding: 8px 12px;
            margin: 0px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            float: right;
            transition: all 0.2s ease-in-out;
        }

        #theme-toggle:hover {
            background-color: var(--theme-toggle-button-hover-background-color);
            transition: all 0.2s ease-in-out;
        }

        #theme-toggle:active {
            background-color: var(--theme-toggle-button-active-background-color);
            transition: all 0.2s ease-in-out;
        }

        .octicon.octicon-mark-github.v-align-middle path {
            fill: var(--github-logo-fill-color);
            transition: all 1s ease-in-out;
        }

        .container {
            width: 100%;
            height: 100vh;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
        }

        .big-container {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .control-button {
            width: 66px;
            height: 66px;
            border-radius: 33px;
            color: var(--control-button-color);
            background-color: var(--control-button-bg-color);
            border: 1px solid var(--control-button-border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 40px;
            font-weight: 400;
            margin: 0px 5px;
            transition: all 0.2s ease-in-out;
        }

        .default-button {
            width: 100px;
            height: 66px;
            border-radius: 18px;
            color: var(--default-button-color);
            background-color: var(--default-button-bg-color);
            border: 2px solid var(--default-button-border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 20px;
            font-weight: 400;
            margin: 0px 5px;
            transition: all 0.2s ease-in-out;
        }

        .default-button:hover,
        .control-button:hover {
            background-color: var(--default-button-hover-bg-color);
        }

        .default-button:active,
        .control-button:active {
            background-color: var(--default-button-active-bg-color);
        }

        .button-container {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            margin: 0px 5px;
        }

        .output-container {
            border-radius: 12px;
            color: var(--output-container-color);
            background-color: var(--output-container-bg-color);
            margin-top: 50px;
            padding: 16px;
            height: 200px;
            border: 2px solid var(--output-container-border-color);
            overflow-y: auto;
            transition: all 1s ease-in-out;
        }

        .output-container::-webkit-scrollbar {
            width: 8px;
        }

        .output-container::-webkit-scrollbar-thumb {
            background-color: var(--output-container-scrollbar-thumb-bg-color);
            border-radius: 4px;
        }

        .main {
            flex: 8;
            margin-right: 20px;
        }

        .value-container {
            flex: 1;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
        }

        .left {
            flex: 3;
            margin-left: 20px;
            padding: 8px;
            float: right;
            width: 50%;
        }

        .bottom {
            flex: 1;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
        }

        .slider-container {
            display: flex;
            justify-content: center;
            margin-bottom: 50px;
        }

        .audio-hz-slider {
            width: 80%;
        }

        .slider {
            appearance: none;
            width: 100%;
            height: 22px;
            border-radius: 40px;
            background-color: var(--slider-bg-color);
            outline: none;
            margin-bottom: 24px;
        }

        .slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 76px;
            height: 42px;
            border-radius: 16px;
            cursor: pointer;
        }

        .slider#hzRange::-webkit-slider-thumb {
            background-color: var(--slider-thumb-bg-color);
        }

        .audio-hz-slider input[type=range] {
            -webkit-appearance: none;
            appearance: none;
        }

        input#hzValue {
            width: 128px;
            height: 78px;
            padding: 0px;
            font-size: 34px;
            color: var(--input-color);
            background-color: var(--input-bg-color);
            border: 1px solid var(--input-border-color);
            border-radius: 18px;
            text-align: center;
            display: block;
            margin: 0 auto;
            margin-bottom: 18px;
        }

        span#hz-unit {
            flex: 1;
            display: inline-block;
            vertical-align: middle;
            font-size: 28px;
            margin-left: 14px;
            padding-bottom: 18px;
            color: var(--span-hz-unit-color);
        }

        div#blank-left {
            flex: 1;
        }

        div#blank-right {
            flex: 1;
        }

        a {
            text-decoration: none;
            color: #777777;
        }

        .bottom-element {
            margin: 10px;
        }

        @media screen and (max-width: 768px) {
            .container {
                flex-direction: column;
                height: auto;
            }

            .main {
                width: 100%;
                margin-right: 0;
            }

            .left {
                width: 88%;
                margin-left: 0;
                padding: 0;
                margin-bottom: 64px;
            }

            .value-container {
                flex-direction: row;
                height: auto;
                margin-bottom: 10px;
            }

            #hzValue {
                width: 80%;
            }

            #hz-unit {
                font-size: 20px;
                padding-bottom: 10px;
            }

            .default-button {
                border-radius: 22px;
                margin: 5px 5px;
            }

            div#blank-top {
                flex: 1;
            }

            .slider-container {
                margin-bottom: 10px;
            }
        }

        @media screen and (max-width: 480px) {
            .default-button {
                width: 80px;
                font-size: 16px;
            }

            .slider {
                height: 16px;
            }

            .slider::-webkit-slider-thumb {
                width: 60px;
                height: 32px;
            }

            .slider::-webkit-slider-thumb:before {
                font-size: 10px;
            }
        }
    </style>

    <script is:inline>
        let needStop = 0;
        let oscillator = null;
        let audioContext = null;

        document.addEventListener("DOMContentLoaded", function() {
            const toggleButton = document.querySelector('#theme-toggle');
            const hzValue = document.getElementById('hzValue');
            const hzRange = document.getElementById('hzRange');
            const decreaseBtn = document.getElementById('decrease');
            const increaseBtn = document.getElementById('increase');
            const output = document.getElementById('output');

            // Initialize value
            hzValue.value = hzRange.value;

            // Theme toggle handled by inline onclick and global Layout script

            // Sync slider and input
            hzRange.addEventListener('input', function() {
                hzValue.value = this.value;
            });

            hzValue.addEventListener('input', function() {
                let val = Math.max(0, Math.min(22050, parseInt(this.value) || 0));
                this.value = val;
                hzRange.value = val;
            });

            // Increase/Decrease buttons
            decreaseBtn.addEventListener('click', function() {
                let val = Math.max(0, parseInt(hzValue.value) - 10);
                hzValue.value = val;
                hzRange.value = val;
            });

            increaseBtn.addEventListener('click', function() {
                let val = Math.min(22050, parseInt(hzValue.value) + 10);
                hzValue.value = val;
                hzRange.value = val;
            });
        });

        function playSound() {
            if (oscillator) {
                stopSound();
            }

            audioContext = new (window.AudioContext || window.webkitAudioContext)();
            oscillator = audioContext.createOscillator();
            oscillator.type = 'sine';
            oscillator.frequency.setValueAtTime(parseFloat(document.getElementById('hzValue').value), audioContext.currentTime);
            oscillator.connect(audioContext.destination);
            oscillator.start();

            const output = document.getElementById('output');
            output.innerHTML += `<div>Playing: ${document.getElementById('hzValue').value} Hz</div>`;
            output.scrollTop = output.scrollHeight;
        }

        function stopSound() {
            if (oscillator) {
                oscillator.stop();
                oscillator = null;
            }
            if (audioContext) {
                audioContext.close();
                audioContext = null;
            }

            const output = document.getElementById('output');
            output.innerHTML += `<div>Stopped</div>`;
            output.scrollTop = output.scrollHeight;
        }
    </script>
</Layout>
